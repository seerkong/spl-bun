<decision #track.migrate_orm_consumers.inverse_members {
  priority = "P0"
  status = "accepted"
  durable_candidate = false
  confidence = "high"
  reversibility = "medium"
}
(
  <question ?>When is a reverse relation represented by an inverse Property?</?>
  <answer { }
  (
    <raw-answer ?>Only when the reverse is a visible domain navigation member.</?>
    <decision-text ?>Visible reverse relations receive a typed inverse Property referring to the fully-qualified owner; invisible reciprocals use the compiler's hidden reverse edge.</?>
    <rationale ?>This preserves public navigation without inventing domain Properties for internal topology.</?>
    <evidence ?>depa ORM owner/inverse projection contract.</?>
  )
  >
)>
